# Ruta del archivo SQLite, relativa a la raiz del proyecto.
# El directorio se crea automaticamente si no existe.
DATABASE_PATH=data/locha.sqlite

# --- Interpretacion con OpenRouter (opcional) ---------------------------
# Sin OPENROUTER_API_KEY y OPENROUTER_MODEL la aplicacion arranca igual,
# pero la captura responde que no esta configurada y no llama al proveedor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# El modelo debe soportar salidas estructuradas (response_format json_schema).
# No se presupone ningun modelo valido: lo elige el operador.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Tiempo maximo de espera de la llamada, en milisegundos.
OPENROUTER_TIMEOUT_MS=20000
# Longitud maxima del texto enviado al proveedor.
OPENROUTER_MAX_INPUT_CHARS=2000
# Longitud maxima de la respuesta del proveedor que se lee, en bytes.
OPENROUTER_MAX_RESPONSE_BYTES=16384

# --- Limites diarios de inferencia --------------------------------------
# Reserva conservadora: el consumo real puede ser menor. Este allowance local
# NO es una garantia de lo que cobre OpenRouter: fija tambien un limite de
# gasto en tu cuenta de OpenRouter.
# Llamadas maximas por dia.
OPENROUTER_MAX_REQUESTS_PER_DAY=100
# Tokens de entrada y salida reservados por llamada.
OPENROUTER_MAX_INPUT_TOKENS_PER_CALL=2000
OPENROUTER_MAX_OUTPUT_TOKENS_PER_CALL=500
# Costo maximo reservado por llamada y presupuesto diario, en microUSD
# (1 USD = 1000000 microUSD).
OPENROUTER_MAX_COST_MICRO_USD_PER_CALL=5000
OPENROUTER_DAILY_BUDGET_MICRO_USD=200000

# --- Bot de Telegram (opcional) -----------------------------------------
# El bot SOLO se activa con las tres variables de abajo. Con una
# configuracion parcial el backend arranca, pero el bot queda desactivado.
# El token lo entrega @BotFather y nunca se registra en ningun log.
TELEGRAM_BOT_TOKEN=
# Id numerico del usuario autorizado (lo dice @userinfobot).
TELEGRAM_ALLOWED_USER_ID=
# Id numerico del chat privado autorizado (en un chat privado coincide con
# el id del usuario).
TELEGRAM_ALLOWED_CHAT_ID=
# Plazo maximo de cada llamada a la API de Telegram, en milisegundos.
# Debe ser mayor que el tiempo del long polling.
TELEGRAM_TIMEOUT_MS=40000
# Longitud maxima de la respuesta de la API que se lee, en bytes.
TELEGRAM_MAX_RESPONSE_BYTES=65536
# Espera maxima del long polling en el lado de Telegram, en segundos.
TELEGRAM_POLL_TIMEOUT_SECONDS=25
